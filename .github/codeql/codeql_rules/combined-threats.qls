- description: "Joplin Combined Custom and Standard Security Rules"

- queries: .

- import: codeql-suites/javascript-security-extended.qls
  from: codeql/javascript-queries

- exclude:
    id:
      - "*xss*"
      - "*ssrf*"
      - js/redos
      - js/polynomial-redos
      - "*request-forgery*"
      - "*url-redirection*"
      - "*regex-injection*"
      - js/bad-tag-filter
      - js/useless-regexp-character-escape
      - js/overly-large-range
      - js/file-system-race
      - js/incomplete-url-substring-sanitization
      - js/incomplete-sanitization
      - js/double-escaping
      - js/incomplete-multi-character-sanitization
      - "*insufficient-password*"
      - "*weak-crypto*"
      - "*insecure-download*"
      - "*http-to-file*"
